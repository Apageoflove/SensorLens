{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SensorLens",
  "mainBinaryName": "sensorlens",
  "version": "0.8.0",
  "identifier": "io.github.apageoflove.adviz",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "publisher": "Apageoflove",
    "copyright": "Apageoflove",
    "category": "DeveloperTool",
    "shortDescription": "SensorLens 感知透镜：智驾多传感器标定与标注可视化",
    "longDescription": "上传图片、JSON 和点云，自动完成坐标系转换，把点、线、框和点云投影到图像上，支持 BEV、3D 视图、多帧拼接和外参检查。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../build/backend/": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5M0EwNzA3MDYwREY0MzkKUldRNTlBMEdCd2M2cVVvbU03OVh5RmdkNUhZdzJZa3BIMVlDQU84bXorTUgxU1ZMcG5rdk92ZW0K",
      "endpoints": [
        "https://github.com/Apageoflove/SensorLens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
